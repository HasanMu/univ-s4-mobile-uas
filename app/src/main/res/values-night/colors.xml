<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night palette — flip warna terang jadi gelap. Warna brand
         (primary amber, role badge) tetep sama supaya identitas visual
         konsisten day/night. -->

    <!-- Background & surfaces -->
    <color name="background">#121417</color>
    <color name="on_background">#F7F8FA</color>

    <color name="surface">#1E2126</color>
    <color name="on_surface">#F7F8FA</color>
    <color name="surface_variant">#2A2E35</color>
    <color name="on_surface_variant">#A0AEC0</color>

    <!-- Outlines & separators -->
    <color name="outline">#4A5058</color>
    <color name="outline_variant">#3A3E45</color>

    <!-- Primary container tetep tapi pake tint gelap supaya kontras -->
    <color name="primary_container">#3D2B0B</color>
    <color name="on_primary_container">#FEF3C7</color>

    <!-- Secondary container gelap -->
    <color name="secondary_container">#2A2E35</color>
    <color name="on_secondary_container">#E2E8F0</color>

    <!-- Error container gelap -->
    <color name="error_container">#4A1919</color>

    <!-- Badge backgrounds tetep muted supaya text-nya (yang statik
         green/red) tetep readable — cukup gelapin sedikit -->
    <color name="badge_aman_bg">#0F3A2E</color>
    <color name="badge_kritis_bg">#3A1919</color>
    <color name="badge_manager_bg">#2D1B47</color>
    <color name="badge_gudang_bg">#3A2A0B</color>
</resources>
