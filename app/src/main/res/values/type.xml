<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Text styles -->
    <style name="TextAppearance.Materialku.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="fontFamily">sans-serif</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Materialku.Title" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Materialku.TitleSmall" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title_sm</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Materialku.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="TextAppearance.Materialku.BodySmall" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textSize">@dimen/text_body_sm</item>
    </style>

    <style name="TextAppearance.Materialku.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="TextAppearance.Materialku.LabelMicro" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">@dimen/text_micro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Materialku.Stat" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textSize">@dimen/text_stat</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Materialku.StatLarge" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_stat_lg</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Button styles -->
    <style name="Widget.Materialku.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:height">@dimen/height_button</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
    </style>

    <style name="Widget.Materialku.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:height">@dimen/height_button</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/outline</item>
    </style>

    <style name="Widget.Materialku.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">true</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Card style -->
    <style name="Widget.Materialku.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/outline_variant</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>

    <!-- TextField style -->
    <style name="Widget.Materialku.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/outline</item>
    </style>
</resources>