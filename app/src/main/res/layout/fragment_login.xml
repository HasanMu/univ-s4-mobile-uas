<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_2xl"
        android:paddingTop="@dimen/spacing_3xl"
        android:paddingBottom="@dimen/spacing_xl">

        <!-- Logo section -->
        <ImageView
            android:layout_width="@dimen/logo_size"
            android:layout_height="@dimen/logo_size"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_3xl"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_materialku" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_xl"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textAppearance="@style/TextAppearance.Materialku.Headline"
            android:textColor="@color/on_background_dark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/app_tagline"
            android:textAppearance="@style/TextAppearance.Materialku.LabelMicro"
            android:textColor="@color/on_surface_variant" />

        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_xl"
            android:background="@color/primary" />

        <!-- Form section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_3xl"
            android:layout_marginBottom="6dp"
            android:text="@string/login_username"
            android:textAppearance="@style/TextAppearance.Materialku.LabelMicro"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilUsername"
            style="@style/Widget.Materialku.TextInputLayout.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:hint="@string/login_username_hint"
            app:startIconDrawable="@drawable/ic_person"
            app:startIconTint="@color/on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusForward="@id/etPassword"
                android:textColor="@color/on_background_dark"
                tools:ignore="LabelFor">

                <requestFocus />
            </com.google.android.material.textfield.TextInputEditText>

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/login_password"
            android:textAppearance="@style/TextAppearance.Materialku.LabelMicro"
            android:textColor="@color/on_surface_variant" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/Widget.Materialku.TextInputLayout.Dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_xl"
            android:hint="@string/login_password_hint"
            app:endIconMode="password_toggle"
            app:endIconTint="@color/on_surface_variant"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="@color/on_surface_variant">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:imeOptions="actionDone"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/on_background_dark"
                tools:ignore="LabelFor" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/spacing_md"
            android:textAppearance="@style/TextAppearance.Materialku.BodySmall"
            android:textColor="@color/error"
            android:visibility="gone"
            tools:text="Username atau password salah"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/Widget.Materialku.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button"
            android:text="@string/login_button" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/spacing_lg"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/primary"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="@dimen/spacing_3xl" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/login_version"
            android:textAppearance="@style/TextAppearance.Materialku.Caption"
            android:textColor="#4A5568" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
