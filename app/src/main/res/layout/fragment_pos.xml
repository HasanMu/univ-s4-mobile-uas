<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:contentDescription="@string/action_back"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/on_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/pos_title"
            android:textAppearance="@style/TextAppearance.Materialku.Title" />
    </LinearLayout>

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_lg">

        <ImageView
            android:layout_width="@dimen/icon_md"
            android:layout_height="@dimen/icon_md"
            android:contentDescription="@string/action_search"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/on_surface_variant" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/pos_search"
            android:textAppearance="@style/TextAppearance.Materialku.Body"
            android:textColor="@color/on_surface_variant" />
    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/spacing_lg"
        android:paddingVertical="@dimen/spacing_sm"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipSemua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@color/primary"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/stok_filter_semua"
                android:textColor="@color/on_primary"
                android:textAppearance="@style/TextAppearance.Materialku.Caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipBahan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@color/surface"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="Bahan"
                android:textColor="@color/on_surface_variant"
                android:textAppearance="@style/TextAppearance.Materialku.Caption" />

            <TextView
                android:id="@+id/chipAlat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/surface"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="Alat"
                android:textColor="@color/on_surface_variant"
                android:textAppearance="@style/TextAppearance.Materialku.Caption" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Material List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPosMaterial"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="@dimen/spacing_lg"
        android:paddingBottom="100dp" />

    <!-- Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCartCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 item"
                android:textAppearance="@style/TextAppearance.Materialku.BodySmall"
                android:textColor="@color/on_surface_variant" />

            <TextView
                android:id="@+id/tvTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rp 0"
                android:textAppearance="@style/TextAppearance.Materialku.Headline"
                android:textColor="@color/on_background" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCheckout"
            style="@style/Widget.Materialku.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/height_button"
            android:text="@string/pos_checkout" />
    </LinearLayout>

</LinearLayout>