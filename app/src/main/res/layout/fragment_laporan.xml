<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/app_bar_height"
        android:background="@color/background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="@dimen/icon_lg"
            android:layout_height="@dimen/icon_lg"
            android:contentDescription="@string/action_back"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/on_background" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/laporan_title"
            android:textAppearance="@style/TextAppearance.Materialku.Title" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xl">

            <!-- Periode -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/laporan_periode"
                android:textAppearance="@style/TextAppearance.Materialku.LabelMicro"
                android:textColor="@color/on_surface_variant" />

            <LinearLayout
                android:id="@+id/periodePicker"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:background="@color/surface"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_lg">

                <TextView
                    android:id="@+id/tvPeriodeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/laporan_periode_hari"
                    android:textAppearance="@style/TextAppearance.Materialku.Body" />

                <ImageView
                    android:layout_width="@dimen/icon_md"
                    android:layout_height="@dimen/icon_md"
                    android:src="@android:drawable/arrow_down_float"
                    app:tint="@color/on_surface_variant" />
            </LinearLayout>

            <!-- Summary Total -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                app:cardBackgroundColor="@color/primary"
                app:cardCornerRadius="@dimen/radius_card"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="22dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/laporan_total"
                        android:textAppearance="@style/TextAppearance.Materialku.LabelMicro"
                        android:textColor="@color/on_primary" />

                    <TextView
                        android:id="@+id/tvTotalTrx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:text="12"
                        android:textAppearance="@style/TextAppearance.Materialku.StatLarge"
                        android:textColor="@color/on_primary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Summary Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Materialku.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_md"
                    android:layout_weight="1"
                    app:contentPadding="@dimen/padding_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/laporan_pendapatan"
                            android:textAppearance="@style/TextAppearance.Materialku.LabelMicro"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/tvPendapatan"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="Rp 0"
                            android:textAppearance="@style/TextAppearance.Materialku.Stat"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.Materialku.CardView"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:contentPadding="@dimen/padding_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/laporan_terjual"
                            android:textAppearance="@style/TextAppearance.Materialku.LabelMicro"
                            android:textColor="@color/on_surface_variant" />

                        <TextView
                            android:id="@+id/tvTerjual"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_sm"
                            android:text="0 unit"
                            android:textAppearance="@style/TextAppearance.Materialku.Stat"
                            android:textColor="@color/on_surface" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Transaction Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/laporan_trx_terbaru"
                android:textAppearance="@style/TextAppearance.Materialku.LabelMicro"
                android:textColor="@color/on_surface_variant" />

            <LinearLayout
                android:id="@+id/rvTrx"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:orientation="vertical">

                <!-- TODO: transaction list items -->
            </LinearLayout>

            <!-- Kritis Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_md"
                android:text="@string/laporan_stok_kritis"
                android:textAppearance="@style/TextAppearance.Materialku.LabelMicro"
                android:textColor="@color/on_surface_variant" />

            <LinearLayout
                android:id="@+id/rvKritis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:orientation="vertical">

                <!-- populated dinamis dari LaporanFragment -->
            </LinearLayout>

            <TextView
                android:id="@+id/tvKritisEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:text="@string/laporan_kritis_kosong"
                android:textAppearance="@style/TextAppearance.Materialku.Caption"
                android:textColor="@color/on_surface_variant"
                android:visibility="gone" />

            <!-- Export Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExport"
                style="@style/Widget.Materialku.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:text="@string/laporan_export" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>